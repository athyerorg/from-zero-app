# Copy to .env.local and fill from Supabase → Settings → API Keys.
# Both values are PUBLIC by design (they go into the website). Secrets never go here.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxxx
# Moyasar PUBLISHABLE key (pk_test_… then pk_live_…). Public by design. The SECRET key goes only
# into Supabase → Edge Functions → Secrets as MOYASAR_SECRET_KEY, never here.
VITE_MOYASAR_PK=pk_test_xxxx
